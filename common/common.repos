# Shared Record -> Train -> Deploy pipeline, imported by every application.
#
# One pin serves all applications on purpose: identical contract format,
# recorder, and dataset layout across applications is the point of the
# pipeline. Applications may be on different ROS distributions, so these are
# shared as SOURCE and compiled separately into each application's install/.
# If a SHA here ever fails to build under one application's distro, that is a
# signal worth seeing — document the divergence before pinning per-app.
repositories:
  rosetta:
    type: git
    url: https://github.com/iblnkn/rosetta.git
    version: fb3860cdd4bcc25dd301bb7bcbf1a58a70ade8ac
  rosetta_interfaces:
    type: git
    url: https://github.com/iblnkn/rosetta_interfaces.git
    version: 90e979108b9b8cdbe791697ee9a338192e16e9fc
  lerobot-robot-rosetta:
    type: git
    url: https://github.com/iblnkn/lerobot-robot-rosetta.git
    version: e4ed91ee5cd58c0163dabf0af699d3e3c1f193dc
