<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so_arm101">
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="color" default="0.2 0.7 0.85 1.0" />

  <!-- Scene poses (from config/scene/poses.yaml, refresh via scripts/refresh_scene.py) -->
  <xacro:arg name="table_x" default="0.2" />
  <xacro:arg name="table_y" default="0.0" />
  <xacro:arg name="table_z" default="0.38" />
  <xacro:arg name="tray_x" default="0.06" />
  <xacro:arg name="tray_y" default="0.0" />
  <xacro:arg name="tray_z" default="0.3945" />
  <xacro:arg name="tray_roll" default="0.0" />
  <xacro:arg name="tray_pitch" default="0.0" />
  <xacro:arg name="tray_yaw" default="0.0" />
  <xacro:arg name="cube_small_x" default="0.28" />
  <xacro:arg name="cube_small_y" default="-0.1" />
  <xacro:arg name="cube_small_z" default="0.4055" />
  <xacro:arg name="cube_medium_x" default="0.16" />
  <xacro:arg name="cube_medium_y" default="0.05" />
  <xacro:arg name="cube_medium_z" default="0.4086" />
  <xacro:arg name="cube_large_x" default="0.26" />
  <xacro:arg name="cube_large_y" default="0.12" />
  <xacro:arg name="cube_large_z" default="0.4118" />
  <xacro:arg name="arm_base_x" default="0.38" />
  <xacro:arg name="arm_base_y" default="0.0" />
  <xacro:arg name="arm_base_z" default="0.4" />
  <xacro:arg name="arm_base_roll" default="0.0" />
  <xacro:arg name="arm_base_pitch" default="0.0" />
  <xacro:arg name="arm_base_yaw" default="3.14159" />

  <!-- The SO-ARM101 robot -->
  <link name="world" />

  <material name="table_top">
    <color rgba="0.18 0.18 0.2 1" />
  </material>
  <material name="table_leg">
    <color rgba="0.82 0.84 0.86 1" />
  </material>
  <material name="tray">
    <color rgba="0.95 0.95 0.96 1" />
  </material>

  <!-- Table and tray (match scene.xml for RViz visualization) -->
  <link name="table_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.66 0.6 0.026" />
      </geometry>
      <material name="table_top" />
    </visual>
    <visual>
      <origin xyz="-0.315 0.285 -0.1965" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.03 0.367" />
      </geometry>
      <material name="table_leg" />
    </visual>
    <visual>
      <origin xyz="0.315 0.285 -0.1965" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.03 0.367" />
      </geometry>
      <material name="table_leg" />
    </visual>
    <visual>
      <origin xyz="-0.315 -0.285 -0.1965" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.03 0.367" />
      </geometry>
      <material name="table_leg" />
    </visual>
    <visual>
      <origin xyz="0.315 -0.285 -0.1965" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.03 0.367" />
      </geometry>
      <material name="table_leg" />
    </visual>
  </link>
  <joint name="table_joint" type="fixed">
    <parent link="world" />
    <child link="table_link" />
    <origin xyz="$(arg table_x) $(arg table_y) $(arg table_z)" rpy="0 0 0" />
  </joint>

  <link name="tray_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.12 0.16 0.003" />
      </geometry>
      <material name="tray" />
    </visual>
    <visual>
      <origin xyz="0 0.0785 0.0115" rpy="0 0 0" />
      <geometry>
        <box size="0.12 0.003 0.02" />
      </geometry>
      <material name="tray" />
    </visual>
    <visual>
      <origin xyz="0 -0.0785 0.0115" rpy="0 0 0" />
      <geometry>
        <box size="0.12 0.003 0.02" />
      </geometry>
      <material name="tray" />
    </visual>
    <visual>
      <origin xyz="-0.0585 0 0.0115" rpy="0 0 0" />
      <geometry>
        <box size="0.003 0.16 0.02" />
      </geometry>
      <material name="tray" />
    </visual>
    <visual>
      <origin xyz="0.0585 0 0.0115" rpy="0 0 0" />
      <geometry>
        <box size="0.003 0.16 0.02" />
      </geometry>
      <material name="tray" />
    </visual>
  </link>
  <joint name="tray_joint" type="fixed">
    <parent link="world" />
    <child link="tray_link" />
    <origin xyz="$(arg tray_x) $(arg tray_y) $(arg tray_z)" rpy="$(arg tray_roll) $(arg tray_pitch) $(arg tray_yaw)" />
  </joint>

  <!-- Cubes (match scene.xml initial positions for RViz) -->
  <link name="cube_small_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.025 0.025" />
      </geometry>
      <material name="cube_small">
        <color rgba="0.9 0.3 0.2 1" />
      </material>
    </visual>
  </link>
  <joint name="cube_small_joint" type="fixed">
    <parent link="world" />
    <child link="cube_small_link" />
    <origin xyz="$(arg cube_small_x) $(arg cube_small_y) $(arg cube_small_z)" rpy="0 0 0" />
  </joint>

  <link name="cube_medium_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.0312 0.0312 0.0312" />
      </geometry>
      <material name="cube_medium">
        <color rgba="0.2 0.7 0.4 1" />
      </material>
    </visual>
  </link>
  <joint name="cube_medium_joint" type="fixed">
    <parent link="world" />
    <child link="cube_medium_link" />
    <origin xyz="$(arg cube_medium_x) $(arg cube_medium_y) $(arg cube_medium_z)" rpy="0 0 0" />
  </joint>

  <link name="cube_large_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.0376 0.0376 0.0376" />
      </geometry>
      <material name="cube_large">
        <color rgba="0.2 0.4 0.9 1" />
      </material>
    </visual>
  </link>
  <joint name="cube_large_joint" type="fixed">
    <parent link="world" />
    <child link="cube_large_link" />
    <origin xyz="$(arg cube_large_x) $(arg cube_large_y) $(arg cube_large_z)" rpy="0 0 0" />
  </joint>

  <xacro:include filename="$(find so_arm101_description)/urdf/so_arm101_macro.xacro" />
  <xacro:so_arm101 prefix="$(arg prefix)" color="$(arg color)" parent="world"
    x="$(arg arm_base_x)" y="$(arg arm_base_y)" z="$(arg arm_base_z)"
    roll="$(arg arm_base_roll)" pitch="$(arg arm_base_pitch)" yaw="$(arg arm_base_yaw)" />

  <!-- Overhead camera link -->
  <link name="camera_color_mujoco_frame"/>
  <joint name="camera_color_mujoco_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_color_mujoco_frame"/>
    <origin xyz="0.0 0.0 0.5" rpy="0 2.356 0.0"/>
  </joint>

  <!-- ros2_control information including camera sensor -->
  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(find pai_bringup)/mjcf/scene.xml</param>
      <param name="sim_speed_factor">1.0</param>
      <param name="camera_publish_rate">10.0</param>
    </hardware>

    <joint name="$(arg prefix)shoulder_pan_joint">
      <param name="initial_position">0.0</param>
      <param name="id">1</param>
      <param name="p_cofficient">8</param>
      <param name="offset">2048</param>
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="$(arg prefix)shoulder_lift_joint">
      <param name="id">2</param>
      <param name="p_cofficient">16</param>
      <param name="offset">2125</param>
      <param name="initial_position">0.0</param>
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="$(arg prefix)elbow_flex_joint">
      <param name="id">3</param>
      <param name="offset">2080</param>
      <param name="p_cofficient">16</param>
      <param name="initial_position">0.0</param>
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="$(arg prefix)wrist_flex_joint">
      <param name="id">4</param>
      <param name="offset">3110</param>
      <param name="p_cofficient">16</param>
      <param name="initial_position">0.0</param>
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="$(arg prefix)wrist_roll_joint">
      <param name="id">5</param>
      <param name="offset">1024</param>
      <param name="p_cofficient">16</param>
      <param name="initial_position">0.0</param>
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="$(arg prefix)gripper_joint">
      <param name="id">6</param>
      <param name="offset">2070</param>
      <param name="p_cofficient">16</param>
      <param name="initial_position">0.0</param>
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <!-- Camera informatiom -->
    <sensor name="camera">
      <param name="frame_name">camera_color_mujoco_frame</param>
      <param name="info_topic">/camera/info</param>
      <param name="image_topic">/camera</param>
      <param name="depth_topic">/camera/depth</param>
    </sensor>
  </ros2_control>

</robot>
