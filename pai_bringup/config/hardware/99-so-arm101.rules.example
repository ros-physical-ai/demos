# Udev rules example for PAI arm and camera symlinks.
#
# Creates stable device names so that arm launch commands and camera config YAMLs
# always find the right device regardless of USB enumeration order:
#
#   /dev/so101_leader    → leader arm
#   /dev/so101_follower  → follower arm
#   /dev/cam_wrist       → wrist camera (mounted on gripper)
#   /dev/cam_static      → static camera (looking down)
#
# We match cameras by ID_PATH — the full hardware bus path that udev
# assigns to each USB port (e.g. pci-0000:00:14.0-usb-0:1.3:1.0).
# This is preferred over ID_SERIAL_SHORT because identical camera
# models often share the same serial number (or expose none at all),
# making serial-based matching unreliable when two of the same camera
# are connected.  ID_PATH is always unique per physical USB port.
#
# Preconditions:
#   - Each camera must stay plugged into the SAME physical USB port
#     across reboots.  Moving a cable to a different port changes
#     its ID_PATH and breaks the symlink.
#   - USB hubs are fine — each downstream port gets its own path.
#
# ── Setup ──────────────────────────────────────────────────────────
#
# 1. Plug in each arm and find its
#
#     # Arms (e.g., for device /dev/ttyACM0)
#     udevadm info --query=property --name=/dev/ttyACM0 | egrep 'ID_VENDOR_ID|ID_MODEL_ID|ID_SERIAL_SHORT|ID_PATH'
#
#     Example output:
#       ID_MODEL_ID=55d3
#       ID_SERIAL_SHORT=5B14033172
#       ID_VENDOR_ID=1a86
#       ID_PATH_WITH_USB_REVISION=pci-0000:67:00.0-usbv2-0:1:1.0
#       ID_PATH=pci-0000:67:00.0-usb-0:1:1.0
#       ID_PATH_TAG=pci-0000_67_00_0-usb-0_1_1_0
#
#     # Cameras (e.g., for device /dev/video0)
#     udevadm info --name=/dev/video0 --query=all | egrep 'ID_VENDOR_ID|ID_MODEL_ID|ID_SERIAL_SHORT|ID_PATH'
#
#     Example output:
#       E: ID_MODEL_ID=0010
#       E: ID_SERIAL_SHORT=SN0001
#       E: ID_VENDOR_ID=3277
#       E: ID_PATH_WITH_USB_REVISION=pci-0000:6a:00.0-usbv2-0:1:1.0
#       E: ID_PATH=pci-0000:6a:00.0-usb-0:1:1.0
#       E: ID_PATH_TAG=pci-0000_6a_00_0-usb-0_1_1_0
#
# 2. For the arms, replace <LEADER_ID_VENDOR_ID>, <LEADER_ID_MODEL_ID>, <LEADER_ID_SERIAL_SHORT>,
#    <FOLLOWER_ID_VENDOR_ID>, <FOLLOWER_ID_MODEL_ID>, <FOLLOWER_ID_SERIAL_SHORT>, with the actual
#    respective values from step 1.
#
#    For the cameras, replace <WRIST_ID_PATH> and <STATIC_ID_PATH> below with the actual
#    ID_PATH values from step 1.
#
# 3. Copy this file (without the .example suffix) to /etc/udev/rules.d/:
#
#      sudo cp 99-so-arm101.rules.example /etc/udev/rules.d/99-so-arm101.rules
#
#    Then edit the file in /etc/udev/rules.d/ with the real paths.
#
# 4. Reload udev rules:
#
#      sudo udevadm control --reload-rules && sudo udevadm trigger
#
# 5. Verify:
#
#      ls -l /dev/so101_leader /dev/so101_follower /dev/cam_wrist /dev/cam_overhead
#
#    If you install ffmpeg (sudo apt install ffmpeg), you can verify cameras by streaming the video using your new device name.
#
#      ffplay -f v4l2 -input_format mjpeg -video_size 1280x720 /dev/cam_static
#
# ── Notes ──────────────────────────────────────────────────────────
#
# - ATTR{index}=="0" selects the main video stream (not metadata).
# - If your cameras have truly unique serial numbers you can match
#   with ENV{ID_SERIAL_SHORT} instead of ENV{ID_PATH}.


# --- Arms ---
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="<LEADER_ID_VENDOR_ID>",   ENV{ID_MODEL_ID}=="<LEADER_ID_MODEL_ID>",   ENV{ID_SERIAL_SHORT}=="<LEADER_ID_SERIAL_SHORT>",   SYMLINK+="so101_leader",   GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="<FOLLOWER_ID_VENDOR_ID>", ENV{ID_MODEL_ID}=="<FOLLOWER_ID_MODEL_ID>", ENV{ID_SERIAL_SHORT}=="<FOLLOWER_ID_SERIAL_SHORT>", SYMLINK+="so101_follower", GROUP="dialout", MODE="0660"

# --- Cameras ---
SUBSYSTEM=="video4linux", ATTR{index}=="0", ENV{ID_PATH}=="<WRIST_ID_PATH>",  SYMLINK+="cam_wrist",  MODE="0660", GROUP="video"
SUBSYSTEM=="video4linux", ATTR{index}=="0", ENV{ID_PATH}=="<STATIC_ID_PATH>", SYMLINK+="cam_static", MODE="0660", GROUP="video"
