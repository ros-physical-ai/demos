        gripper_frame_link:
          Value: true
        gripper_link:
          Value: true
        jaw_link:
          Value: true
        lower_arm_link:
          Value: true
        shoulder_link:
          Value: true
        static_camera_link:
          Value: true
        upper_arm_link:
          Value: true
        world:
          Value: true
        wrist_camera_link:
          Value: true
        wrist_link:
          Value: true
