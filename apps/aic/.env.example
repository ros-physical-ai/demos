# Copy to `.env` and edit. Every value below is the compose default, which is
# the `trial_1` scene from aic_engine's sample config.

# Gazebo window. `false` for headless machines and CI.
AIC_GAZEBO_GUI=true

# Task board pose in the world, meters and radians.
AIC_TASK_BOARD_X=0.15
AIC_TASK_BOARD_Y=-0.2
AIC_TASK_BOARD_Z=1.14
AIC_TASK_BOARD_YAW=3.1415

# Rail mounts: presence and translation along the rail, meters.
# Translation range is -0.09625 to 0.09625.
AIC_NIC_CARD_MOUNT_0_PRESENT=true
AIC_NIC_CARD_MOUNT_0_TRANSLATION=0.036
AIC_SC_PORT_0_PRESENT=true
AIC_SC_PORT_0_TRANSLATION=0.042
AIC_SC_PORT_0_YAW=0.1
AIC_LC_MOUNT_RAIL_0_PRESENT=true
AIC_LC_MOUNT_RAIL_0_TRANSLATION=0.02
AIC_SFP_MOUNT_RAIL_0_PRESENT=true
AIC_SFP_MOUNT_RAIL_0_TRANSLATION=0.03
AIC_SC_MOUNT_RAIL_0_PRESENT=true
AIC_SC_MOUNT_RAIL_0_TRANSLATION=-0.02
AIC_LC_MOUNT_RAIL_1_PRESENT=true
AIC_LC_MOUNT_RAIL_1_TRANSLATION=-0.01

# Cable held by the gripper: `sfp_sc_cable` or `sfp_sc_cable_reversed`.
AIC_CABLE_TYPE=sfp_sc_cable
