<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pai_aic</name>
  <version>0.1.0</version>
  <description>Record, train and deploy on the AIC cable-insertion simulator with rosetta.</description>
  <maintainer email="franco.cipollone@ekumenlabs.com">Franco Cipollone</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>aic_control_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosetta</exec_depend>
  <exec_depend>rosetta_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
