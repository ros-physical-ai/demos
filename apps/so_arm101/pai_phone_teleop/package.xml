<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pai_phone_teleop</name>
  <version>0.1.0</version>
  <description>
    Phone-based 6-DoF pose teleoperation adapter for the pai_teleop_ik IK servo.
    Embeds the upstream teleop WebXR bridge and publishes the phone's 6-DoF pose
    as a Cartesian target; the servo runs the Pink differential IK and streams
    joint commands. The adapter owns no IK or kinematics.
  </description>
  <maintainer email="franco.cipollone@ekumenlabs.com">Franco Cipollone</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pai_teleop_ik</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>teleop</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
