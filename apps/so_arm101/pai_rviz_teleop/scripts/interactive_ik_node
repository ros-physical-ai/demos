"""Interactive marker teleop adapter.

A thin RViz frontend for the ``pai_teleop_ik`` IK servo. It owns no IK or
kinematics: it just lets you drag a 6-DOF interactive marker and publishes the
marker pose as a Cartesian target for the servo to track.

Pipeline:

  1. Subscribe to ``ee_pose`` (the servo's current commanded tool pose). On the
     first message, spawn a 6-DOF interactive marker at that pose so it starts
     exactly where the arm is.
  2. On every marker drag past the deadband, publish the marker pose to
     ``target_pose`` (a ``geometry_msgs/PoseStamped`` in ``root_frame``). The
     servo resolves the frame and solves IK.
  3. A right-click menu toggles the gripper: an animation timer ramps a gripper
     setpoint between open/closed and publishes it on ``gripper_command``
     (``std_msgs/Float64``). "Reset" snaps the marker back to the latest
     ``ee_pose``.

The IK solver, Pinocchio model, and joint command streaming all live in the
servo node; this adapter imports none of them.
"""

import threading

import numpy as np
import rclpy
from geometry_msgs.msg import Pose, PoseStamped
from interactive_markers import InteractiveMarkerServer, MenuHandler
from rclpy.callback_groups import MutuallyExclusiveCallbackGroup
from rclpy.node import Node
from std_msgs.msg import Float64
from visualization_msgs.msg import (
    InteractiveMarker,
    InteractiveMarkerControl,
    InteractiveMarkerFeedback,
    Marker,
)


def _pose_delta(a: Pose, b: Pose) -> float:
    """Return a rough 6D distance (metres + radians) between two poses."""
    dp = np.array([a.position.x - b.position.x, a.position.y - b.position.y, a.position.z - b.position.z])
    qa = np.array([a.orientation.x, a.orientation.y, a.orientation.z, a.orientation.w])
    qb = np.array([b.orientation.x, b.orientation.y, b.orientation.z, b.orientation.w])
    dot = abs(float(np.dot(qa, qb)))
    ang = 2.0 * np.arccos(min(1.0, dot))
    return float(np.linalg.norm(dp) + ang)


class InteractiveIKNode(Node):
    """Publishes a 6-DOF interactive marker pose as a Cartesian target."""

    def __init__(self):
        """Initialize parameters, ROS I/O, and the interactive marker server."""
        super().__init__("interactive_ik_node")

        # The marker is anchored in (and its pose published relative to) this
        # frame, which must match the servo's root_frame.
        self.declare_parameter("root_frame", "world")
        self.declare_parameter("control_rate", 50.0)
        # Marker move deadband: minimum pose change (metres + radians) for a
        # feedback update to count. Updates below this are ignored so holding the
        # mouse down without moving does not refresh the target.
        self.declare_parameter("marker_deadband", 2e-3)
        # Topics shared with the servo.
        self.declare_parameter("target_pose_topic", "ik_servo/target_pose")
        self.declare_parameter("gripper_command_topic", "ik_servo/gripper_command")
        self.declare_parameter("ee_pose_topic", "ik_servo/ee_pose")
        # Gripper toggle: whether this arm has a gripper, the open/closed
        # setpoints (rad), and the toggle animation speed (rad/s).
        self.declare_parameter("has_gripper", True)
        self.declare_parameter("gripper_open_position", 1.7)
        self.declare_parameter("gripper_closed_position", 0.0)
        self.declare_parameter("gripper_speed", 1.0)

        self.root_frame = self.get_parameter("root_frame").value
        self.control_rate = float(self.get_parameter("control_rate").value)
        self.marker_deadband = float(self.get_parameter("marker_deadband").value)
        self._has_gripper = bool(self.get_parameter("has_gripper").value)
        self.gripper_open = float(self.get_parameter("gripper_open_position").value)
        self.gripper_closed = float(self.get_parameter("gripper_closed_position").value)
        self.gripper_speed = float(self.get_parameter("gripper_speed").value)

        # State shared between the ee_pose callback, marker feedback, and the
        # gripper animation timer. Guarded by a lock since callbacks run in
        # parallel.
        self._lock = threading.Lock()
        self._latest_ee_pose: Pose | None = None  # latest servo ee_pose
        self._target_pose: Pose | None = None  # last accepted marker pose
        self._gripper_cmd = 0.0  # commanded gripper position (animated)
        self._gripper_target = None  # open/closed setpoint; None => hold
        self._marker_initialized = False

        # ROS interfaces.
        self._target_pub = self.create_publisher(PoseStamped, self.get_parameter("target_pose_topic").value, 10)
        self._gripper_pub = self.create_publisher(Float64, self.get_parameter("gripper_command_topic").value, 10)
        self.create_subscription(PoseStamped, self.get_parameter("ee_pose_topic").value, self._ee_pose_cb, 10)
        self._marker_server = InteractiveMarkerServer(self, "interactive_ik")

        # Right-click context menu on the marker.
        self._menu_handler = MenuHandler()
        if self._has_gripper:
            self._menu_handler.insert("Toggle gripper (open/close)", callback=self._on_toggle_gripper)
        self._menu_handler.insert("Reset to current end-effector pose", callback=self._on_reset)

        # Gripper animation timer on its own callback group.
        self._control_group = MutuallyExclusiveCallbackGroup()
        if self._has_gripper:
            self.create_timer(1.0 / self.control_rate, self._gripper_loop, callback_group=self._control_group)

        self.get_logger().info(
            f"Interactive IK adapter ready. Drag the marker in RViz; its pose is "
            f"published on '{self.get_parameter('target_pose_topic').value}'."
        )

    # ------------------------------------------------------------------
    # ee_pose callback
    # ------------------------------------------------------------------
    def _ee_pose_cb(self, msg: PoseStamped):
        """Cache the servo's commanded tool pose; spawn the marker on first msg."""
        with self._lock:
            self._latest_ee_pose = msg.pose
            if not self._marker_initialized:
                self._target_pose = msg.pose
                self._spawn_marker(msg.pose)
                self._marker_initialized = True
                self.get_logger().info("Interactive marker initialized at current end-effector pose.")

    def _spawn_marker(self, pose: Pose):
        """Create the 6-DOF interactive marker at the given pose."""
        int_marker = InteractiveMarker()
        int_marker.header.frame_id = self.root_frame
        int_marker.name = "ee_target"
        int_marker.description = "IK target"
        int_marker.scale = 0.12
        int_marker.pose = pose

        # A small sphere so the control handles have something to anchor to.
        sphere = Marker()
        sphere.type = Marker.SPHERE
        sphere.scale.x = sphere.scale.y = sphere.scale.z = 0.03
        sphere.color.r = 0.1
        sphere.color.g = 0.8
        sphere.color.b = 1.0
        sphere.color.a = 0.6
        # MENU interaction so right/left-clicking the sphere opens the context
        # menu (toggle gripper / reset).
        sphere_control = InteractiveMarkerControl()
        sphere_control.always_visible = True
        sphere_control.interaction_mode = InteractiveMarkerControl.MENU
        sphere_control.markers.append(sphere)
        int_marker.controls.append(sphere_control)

        # Add 3 translation + 3 rotation controls (standard 6-DOF gizmo).
        for axis, (x, y, z) in (("x", (1, 0, 0)), ("y", (0, 1, 0)), ("z", (0, 0, 1))):
            for mode, suffix in (
                (InteractiveMarkerControl.MOVE_AXIS, "move"),
                (InteractiveMarkerControl.ROTATE_AXIS, "rotate"),
            ):
                control = InteractiveMarkerControl()
                control.name = f"{suffix}_{axis}"
                control.orientation.w = 1.0
                control.orientation.x = float(x)
                control.orientation.y = float(y)
                control.orientation.z = float(z)
                control.interaction_mode = mode
                int_marker.controls.append(control)

        self._marker_server.insert(int_marker, feedback_callback=self._marker_feedback)
        self._menu_handler.apply(self._marker_server, int_marker.name)
        self._marker_server.applyChanges()

    def _marker_feedback(self, feedback: InteractiveMarkerFeedback):
        """Publish the dragged marker pose as a target when it moves past the deadband.

        RViz emits POSE_UPDATE feedback even while the mouse is held down without
        moving. Ignoring sub-deadband changes means a held-still marker does not
        republish, so the servo's inactivity gate lets the arm settle.
        """
        if feedback.event_type != InteractiveMarkerFeedback.POSE_UPDATE:
            return
        with self._lock:
            if self._target_pose is not None and _pose_delta(self._target_pose, feedback.pose) < self.marker_deadband:
                return
            self._target_pose = feedback.pose

        msg = PoseStamped()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.header.frame_id = self.root_frame
        msg.pose = feedback.pose
        self._target_pub.publish(msg)

    # ------------------------------------------------------------------
    # Menu callbacks
    # ------------------------------------------------------------------
    def _on_toggle_gripper(self, feedback: InteractiveMarkerFeedback):
        """Flip the gripper setpoint between open and closed (animated)."""
        with self._lock:
            reference = self._gripper_target if self._gripper_target is not None else self._gripper_cmd
            # Move toward whichever setpoint is farther from the current one.
            to_open = abs(reference - self.gripper_open)
            to_closed = abs(reference - self.gripper_closed)
            self._gripper_target = self.gripper_closed if to_open < to_closed else self.gripper_open
            target = self._gripper_target
        state = "open" if target == self.gripper_open else "closed"
        self.get_logger().info(f"Gripper toggling {state} -> {target:.3f} rad at {self.gripper_speed:.2f} rad/s.")

    def _on_reset(self, feedback: InteractiveMarkerFeedback):
        """Snap the marker and target back to the current end-effector pose."""
        with self._lock:
            pose = self._latest_ee_pose
            if pose is None:
                self.get_logger().warn("Reset ignored: end-effector pose not available yet.")
                return
            self._target_pose = pose
            self._gripper_target = None

        # Pass no header so the marker keeps its original (untimestamped) header
        # from insert(). Supplying a stamped header makes RViz transform the
        # marker via TF at that exact stamp; a mismatch leaves the marker in place
        # and desyncs it from the target.
        self._marker_server.setPose("ee_target", pose)
        self._marker_server.applyChanges()
        self.get_logger().info("Reset marker and target to current end-effector pose.")

    # ------------------------------------------------------------------
    # Gripper animation loop
    # ------------------------------------------------------------------
    def _gripper_loop(self):
        """Advance the commanded gripper position toward its setpoint and publish."""
        dt = 1.0 / self.control_rate
        with self._lock:
            if self._gripper_target is None:
                return
            step = self.gripper_speed * dt
            diff = self._gripper_target - self._gripper_cmd
            if abs(diff) <= step:
                self._gripper_cmd = self._gripper_target
                self._gripper_target = None  # reached the setpoint; stop animating
            else:
                self._gripper_cmd += float(np.sign(diff)) * step
            lo, hi = sorted((self.gripper_closed, self.gripper_open))
            self._gripper_cmd = float(np.clip(self._gripper_cmd, lo, hi))
            cmd_value = self._gripper_cmd

        self._gripper_pub.publish(Float64(data=cmd_value))


def main(args=None):
    """Entry point for the interactive IK adapter."""
    rclpy.init(args=args)
    node = InteractiveIKNode()
    executor = rclpy.executors.MultiThreadedExecutor()
    executor.add_node(node)
    try:
        executor.spin()
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
